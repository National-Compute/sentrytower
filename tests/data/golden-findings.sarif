          "informationUri": "https://github.com/National-Compute/sentrytower",
          "rules": [
            {
              "id": "CWE-22",
              "name": "PathTraversal",
              "shortDescription": {
                "text": "Path Traversal"
              },
              "fullDescription": {
                "text": "Path Traversal (CWE-22)"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/22.html",
              "help": {
                "text": "Path Traversal. See https://cwe.mitre.org/data/definitions/22.html."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-22"
                ],
                "security-severity": "8.0",
                "precision": "medium",
                "problem.severity": "error"
              }
            },
            {
