{
  "schema_version": 1,
  "description": "Aggregate results of the benchmarks of an earlier internal build of SentryTower with GLM 5.3 Flash, before the public release; they measure no release and no default model of a release. Our own tests, pre-registered. Aggregates only: no per-advisory data, no answer keys, no repository lists.",
  "conditions": {
    "model": "z-ai/glm-5.3-flash via OpenRouter, the same model for every harness and every role",
    "budget_per_run": {
      "tokens": 20000000,
      "wall_clock_seconds": 14400
    },
    "sandbox": "the same offline sandbox for every harness, with access to the model endpoint only; Codex Security ran in its own Bubblewrap sandbox inside it, and Clearwing ran with a local implementation of its sandbox protocol in place of Docker",
    "runs": "one run for each repository version",
    "detection": "a finding whose location is within 10 lines of the true vulnerable operation; strict location matcher: spans of at most 31 lines, at most 3 locations for each finding, calibrated on development data so that no harness wins by chance matches",
    "false_alarm": "a finding on the fixed lines of the fixed version",
    "intervals": "90% paired cluster-bootstrap intervals over repositories"
  },
