{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/National-Compute/sentrytower/v1/src/sentrytower/schemas/findings-v1.schema.json",
  "title": "SentryTower findings",
  "description": "The findings of one SentryTower run (findings.json). Version 1.x of the format: a minor version adds optional fields only.",
  "type": "object",
  "required": ["schema_version", "tool", "run", "summary", "findings"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "SentryTower"},
        "version": {"type": "string"}
      }
    },
    "run": {
      "type": "object",
      "required": ["id", "route"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "route": {"enum": ["funnel", "agent"], "description": "The engine that the size rule selected: funnel (1,000 files or fewer) or agent (more)."},
        "started_at": {"type": ["string", "null"]},
        "repository": {"type": ["string", "null"], "description": "The name of the repository folder."},
        "files_counted": {"type": ["integer", "null"], "minimum": 0},
        "result": {
          "type": "object",
          "description": "The result of the run, as in run.json (status, stop_reason, stop_text, failure, spent_usd, cap_usd, units, calls, depth_factor, preview).",
          "properties": {
            "status": {"enum": ["complete", "incomplete", "failed", "interrupted"]},
            "stop_reason": {"enum": ["done", "budget", "token-ceiling", "wall-clock", "provider-error", "engine-error", "interrupted"]},
            "stop_text": {"type": "string"},
            "failure": {"type": ["string", "null"]},
            "spent_usd": {"type": ["number", "null"], "minimum": 0},
            "cap_usd": {"type": ["number", "null"], "minimum": 0},
            "units": {"type": "object"},
            "calls": {"type": "object"},
            "depth_factor": {"type": "number", "minimum": 1},
            "preview": {"type": "boolean"}
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["findings", "by_severity"],
      "properties": {
        "findings": {"type": "integer", "minimum": 0},
        "by_severity": {
          "type": "object",
          "required": ["critical", "high", "medium", "low", "unknown"],
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": ["path", "start_line", "end_line"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1, "description": "The path of the file, relative to the repository root, with / separators."},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "note": {"type": "string", "description": "What this code does in the vulnerability, when the engine gave it."}
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "rank", "title", "severity", "cwe", "location", "related_locations", "explanation", "engine", "route", "fingerprint"],
      "properties": {
        "id": {"type": "string", "pattern": "^ST-[0-9]{3,}$", "description": "The identifier of the finding in this run."},
        "rank": {"type": "integer", "minimum": 1, "description": "The place of the finding in the ranked output of the run."},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "severity": {"enum": ["critical", "high", "medium", "low", "unknown"]},
        "cwe": {"type": "array", "items": {"type": "string", "pattern": "^CWE-[1-9][0-9]*$"}, "description": "CWE identifiers, the most specific first."},
        "location": {
          "oneOf": [{"$ref": "#/$defs/location"}, {"type": "null"}],
          "description": "The primary location: the critical operation. Null when the engine gave no valid location."
        },
        "related_locations": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/location"}},
        "explanation": {"type": "string", "description": "The evidence and the exploit conditions, as one text."},
        "evidence": {"type": "string"},
        "exploit_conditions": {"type": "string"},
        "engine": {
          "enum": ["free-roaming", "deep-check", "single-agent"],
          "description": "free-roaming: the agent session of the funnel on the whole repository; deep-check: an agent session of the funnel on one code unit; single-agent: the agent of the agent route."
        },
        "route": {"enum": ["funnel", "agent"]},
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "The keep score of the blind verification of a deep-check finding (null for other engines)."
        },
        "verification": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "properties": {
                "verdict": {"type": ["string", "null"], "enum": ["exploitable", "safe", "unclear", null]},
                "keep_score": {"type": ["number", "null"]},
                "votes": {"type": ["array", "null"], "items": {"type": ["string", "null"]}},
                "status": {
                  "enum": ["verified", "unverified", "none"],
                  "description": "Verified; unverified when the verification failed, was refused or did not run (see reason); none when the route does not verify the source of the finding."
                },
                "reason": {"type": ["string", "null"], "description": "Why an unverified finding has no verification."}
              }
            }
          ]
        },
        "tier": {
          "enum": [1, 2],
          "description": "1 for the findings of the standard run; 2 for further findings of a deeper run (preview: more checks; effect on findings not yet measured)."
        },
        "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{32}$", "description": "A stable identity across runs: the file, the first CWE and the title."}
      }
    }
  }
}
